# Copy to .env and fill in for anything beyond local dev.

# Secret used to sign/verify login JWTs. A dev default is used if unset
# (with a loud warning at startup) — always set a real random value before
# any real deployment.
JWT_SECRET=

# JWT lifetime — jsonwebtoken duration string (e.g. "8h", "1d").
JWT_EXPIRY=8h

# Shared key for /internal/* routes, which are called service-to-service by
# eva_service (it has no session cookie) rather than by the browser. A dev
# default is used if unset, with a warning at startup — set a real random
# value before any real deployment, and set the SAME value as eva_service's
# INTERNAL_API_KEY.
INTERNAL_API_KEY=

# Set to "production" to require HTTPS for the auth cookie (Secure flag).
# Leave unset for local http://localhost dev — Secure cookies are silently
# dropped over plain HTTP.
NODE_ENV=
