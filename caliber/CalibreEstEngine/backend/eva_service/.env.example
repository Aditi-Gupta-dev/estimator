# Copy to .env and fill in what you need — every value below has a working
# local-dev default in src/config.py, so the only thing strictly required is
# ONE LLM provider key (OpenAI or Groq).

# ── LLM / embedding providers ─────────────────────────────────────────────
# Set OPENAI_API_KEY *or* GROQ_API_KEY. With OPENAI_API_KEY set, embeddings
# use OpenAI; otherwise they fall back to a local sentence-transformers model
# (no key needed). The two embedding spaces are stored separately, so
# switching providers never invalidates the other one's vectors.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set true only on a corporate network that MITMs TLS. Never in production.
OPENAI_SSL_INSECURE=false

GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant

LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Storage (paths are relative to backend/eva_service/) ──────────────────
EVA_DB_PATH=data/eva.db
EVA_MARKDOWN_DIR=data/markdown_cache
EVA_FAISS_DIR=data/faiss_indexes
KNOWLEDGE_HUB_ROOT=../KnowledgeHub

# ── Server ────────────────────────────────────────────────────────────────
EVA_SERVICE_PORT=8001

# ── Peer services ─────────────────────────────────────────────────────────
# estimator_agents — called directly (peer service, not via the Node proxy).
ESTIMATOR_SERVICE_URL=http://localhost:8000

# The Node gateway. EVA calls back to it for /internal/estimator/scenario,
# which runs the same JS estimator engine the browser uses so what-if results
# come from one implementation rather than a second copy of the formulas.
UPLOAD_SERVER_URL=http://localhost:3001
# MUST match upload-server's INTERNAL_API_KEY. A dev default is used if unset
# (both services warn about it) — set a real random value before deploying.
INTERNAL_API_KEY=

# ── Semantic cache ────────────────────────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=0.93
CACHE_PROMOTION_HIT_COUNT=3
CACHE_PROMOTION_INTERVAL_MINUTES=15

# ── Memory ────────────────────────────────────────────────────────────────
MEMORY_EXTRACTION_INTERVAL_MINUTES=20
SHORT_TERM_MESSAGE_LIMIT=20
LONG_TERM_MEMORY_LIMIT=30
